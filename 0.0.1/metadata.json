{
  "name": "news-agent",
  "version": "0.2.8",
  "description": "Smart contract AI agent for answering questions",
  "category": "agent",
  "tags": ["smart-contract", "near"],
  "details": {
    "agent": {
      "defaults": {
        "model": "llama-v3p1-70b-instruct",
        "model_provider": "fireworks",
        "model_temperature": 0.7,
        "model_max_tokens": 16384
      },
      "events": {
        "dbread.near": {
          "standard": "nearai",
          "version": "0.1.0",
          "events": ["run_agent"]
        }
      },
      "env_vars": [
        "master_account_id",
        "master_private_key"
      ]
    }
  },
  "show_entry": true
}